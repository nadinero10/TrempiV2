    "faq": {
      "title": "Frequently Asked Questions",
      "q1": {
        "question": "What is Trempi?",
        "answer": "Trempi is a smart transportation platform that helps communities organize rides to events. Whether it's a conference, festival, or community gathering, Trempi makes it easy to coordinate transportation."
      },
      "q2": {
        "question": "How do I create an event?",
        "answer": "Click 'Create Event', fill in the details, and share the event link or code with your community. It's that simple!"
      },
      "q3": {
        "question": "Is Trempi free?",
        "answer": "Trempi is free for basic use. Create events, offer rides, and request transportation at no cost."
      },
      "q4": {
        "question": "How does ride matching work?",
        "answer": "When you request a ride, Trempi automatically suggests available transportation options from your area to the event."
      },
      "q5": {
        "question": "Is it safe?",
        "answer": "Safety is our priority. All users are verified, and you can see driver details before joining a ride."
      }
    },
